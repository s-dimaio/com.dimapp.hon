{
  "id": "com.dimapp.hon",
  "version": "1.0.2",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "hOn SmartHome"
  },
  "description": {
    "en": "Your laundry, smarter than ever"
  },
  "category": [
    "appliances"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Simone Di Maio",
    "email": "simone.dimaio77@gmail.com"
  },
  "api": {
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "cleanupDiagnostics": {
      "method": "DELETE",
      "path": "/diagnostics"
    },
    "listDiagnosticFiles": {
      "method": "GET",
      "path": "/diagnostic/files"
    },
    "deleteDiagnosticFile": {
      "method": "DELETE",
      "path": "/diagnostic/file/:filename"
    }
  },
  "brandColor": "#2186b1"
}